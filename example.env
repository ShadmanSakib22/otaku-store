# ============================================================
# Ecommerce-Otaku — Environment Variables
# Copy this file to `.env` and fill in real values.
# Never commit real secrets.
# ============================================================

# ------------------------------------------------------------
# Database (Neon PostgreSQL)
# ------------------------------------------------------------
# DATABASE_URL — pooled connection for the application runtime.
# Neon: use the pooled connection string (host contains -pooler, port 5432).
# Example: postgresql://user:password@ep-xyz-pooler.us-east-1.aws.neon.tech/db
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/db"

# DIRECT_URL — direct (non-pooled) connection used by Prisma CLI
# (migrations, seeding). Neon: use the direct connection string.
# Example: postgresql://user:password@ep-xyz.us-east-1.aws.neon.tech/db
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/db"

# ------------------------------------------------------------
# Admin authentication
# ------------------------------------------------------------
# Secret used to sign admin session tokens. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# ------------------------------------------------------------
# Stripe (payments)
# ------------------------------------------------------------
# Stripe secret key. Server-only.
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
# Stripe webhook signing secret. Set in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------
# Algolia (catalogue search)
# ------------------------------------------------------------
# Algolia Application ID. From Dashboard → Settings → API Keys.
ALGOLIA_APP_ID="XXXXX"
# Admin API key — used only server-side to create/update the index.
ALGOLIA_ADMIN_API_KEY="xxxxx"
# Search-only API key — used for server-side storefront queries.
ALGOLIA_SEARCH_API_KEY="xxxxx"

# ------------------------------------------------------------
# Resend (transactional email)
# ------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# From address used for order confirmation emails.
EMAIL_FROM="no-reply@example.com"

# ------------------------------------------------------------
# Vercel Blob (product / CMS images)
# ------------------------------------------------------------
# Read/write token from the Vercel Blob store settings.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------
# Store configuration
# ------------------------------------------------------------
# URL of the deployed application. Used for Stripe return URLs
# and absolute links in emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"